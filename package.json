    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
